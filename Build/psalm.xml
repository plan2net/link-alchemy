<?xml version="1.0"?>
<psalm resolveFromConfigFile="true"
       errorLevel="4"
       cacheDirectory="./.psalm.cache"
       hideExternalErrors="true"
       phpVersion="8.1">
    <projectFiles>
        <directory name="../Classes"/>
        <ignoreFiles>
            <directory name="../vendor" allowMissingFiles="true"/>
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <InternalProperty errorLevel="suppress" />
        <PossiblyUnusedMethod errorLevel="info"/>
        <UnusedClass errorLevel="info"/>
        <MissingOverrideAttribute errorLevel="info"/>
        <UnnecessaryVarAnnotation errorLevel="info"/>
    </issueHandlers>
</psalm>
